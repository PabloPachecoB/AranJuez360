USE_LOCAL_DB=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://user:pass@host:5432/db   # sólo si USE_LOCAL_DB=False
CORS_ALLOWED_ORIGINS=

