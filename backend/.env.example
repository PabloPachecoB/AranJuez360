# ===== Django =====
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
USE_LOCAL_DB=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://user:pass@host:5432/db   # sólo si USE_LOCAL_DB=False
CORS_ALLOWED_ORIGINS=

# ===== Correo (envío de credenciales a empresas) =====
# En DEBUG se imprime en consola. Para Gmail usa una "contraseña de aplicación".
# EMAIL_BACKEND=paseo_erp.correo.SmtpSinDemoBackend   # SMTP real que omite los correos @paseo.bo de demo
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Paseo Aranjuez 360 <no-responder@tu-dominio>

# ===== Enlaces =====
WEB_PANEL_URL=http://localhost:3000
APP_DEEP_LINK=paseo360:/
# URL pública del backend (enlaces de invitación por WhatsApp)
PUBLIC_BASE_URL=http://localhost:8001

# ===== Agente / LLM =====
# LLM_PROVIDER: qwen_local | qwen_cloud
LLM_PROVIDER=qwen_local
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3:8b
# Modelo exclusivo para títulos de conversaciones; vacío = usa QWEN_MODEL.
QWEN_TITLE_MODEL=
# Modelo que entiende notas de voz (p. ej. qwen3.8-omni-flash en la nube). Vacío = sin voz.
QWEN_AUDIO_MODEL=
# QWEN_API_KEY: obligatorio si LLM_PROVIDER=qwen_cloud
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=30
QWEN_TEMPERATURE=0
QWEN_MAX_TOKENS=512
# Voz de Jarvis (edge-tts): es-BO-MarceloNeural | es-BO-SofiaNeural | es-MX-JorgeNeural ...
JARVIS_VOZ=es-BO-SofiaNeural
# Lugares reales visibles desde la pantalla de recepción (opcional; configura piso y referencia locales).
# RECEPCION_PUNTOS_INTERES_JSON='[{"nombre":"Baños","piso":"2","indicaciones":"Frente al ascensor del piso 2"}]'

# ===== Checkpoints LangGraph =====
# AGENT_CHECKPOINT_BACKEND: sqlite | memory
AGENT_CHECKPOINT_BACKEND=sqlite
# AGENT_CHECKPOINT_SQLITE_PATH=agent_checkpoints.sqlite3

# ===== Observabilidad (opcional) =====
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# Proveedor TTS de salida: fish_audio | elevenlabs | edge. Vacío conserva
# el comportamiento previo: ElevenLabs si hay clave; en otro caso edge-tts.
JARVIS_TTS_PROVIDER=
# Fish Audio: obtén la clave y el reference ID de voz desde tu cuenta.
# Modelo: s2.1-pro | s2.1-pro-free
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
# ElevenLabs sigue disponible si JARVIS_TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
# ID de la voz (Jessica: cgSgspJ2msm6clMCkdW9) y modelo (eleven_v3 entiende [excited], [warmly]...)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_v3
