# Copia este archivo como deploy/.env en el VPS y completa los valores.
# NUNCA subas deploy/.env a Git (está en .gitignore).

# ===== Dirección del servidor: elige UNA opción =====
# A) Con dominio propio (apunta su registro A a la IP del VPS):
#      DOMINIO=paseo360.com                y  USAR_HTTPS=True
# B) Sin dominio, con HTTPS gratis (sslip.io): la IP con guiones + .sslip.io
#      DOMINIO=203-0-113-5.sslip.io        y  USAR_HTTPS=True
# C) Sin dominio, solo la IP (sin candado, solo para pruebas):
#      DOMINIO=http://203.0.113.5          y  USAR_HTTPS=False
# En ALLOWED_HOSTS va el nombre sin http(s):// ; en las URL de abajo, con http:// o https://.
DOMINIO=paseo360.com
USAR_HTTPS=True

# ===== Base de datos =====
POSTGRES_DB=paseo360
POSTGRES_USER=paseo360
POSTGRES_PASSWORD=cambia-esta-clave-larga

# ===== Django =====
DEBUG=False
USE_LOCAL_DB=False
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=paseo360.com
CSRF_TRUSTED_ORIGINS=https://paseo360.com
# La web se sirve en el mismo dominio que la API: no hace falta CORS para el panel.
CORS_ALLOWED_ORIGINS=https://paseo360.com

# Enlaces que van en correos y WhatsApp
WEB_PANEL_URL=https://paseo360.com
PUBLIC_BASE_URL=https://paseo360.com
APP_DEEP_LINK=paseo360:/

# ===== Correo (Gmail con contraseña de aplicación) =====
# True solo para presentaciones: el código de login de las cuentas de demo (@paseo.bo)
# se ve con "docker compose logs backend". Los correos reales siempre se envían por correo.
CODIGOS_DEMO_EN_LOG=False
# O mejor: los códigos de las cuentas de demo llegan a este correo (asunto "[Demo: cuenta]")
EMAIL_DEMO_REDIRIGIR=
EMAIL_BACKEND=paseo_erp.correo.SmtpSinDemoBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Paseo Aranjuez 360 <tu-correo@gmail.com>

# ===== Jarvis (Qwen en DashScope) =====
LLM_PROVIDER=qwen_cloud
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_AUDIO_MODEL=qwen3.8-omni-flash
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=30
QWEN_TEMPERATURE=0
QWEN_MAX_TOKENS=512
AGENT_CHECKPOINT_BACKEND=sqlite

# ===== Voz de Jarvis =====
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_v3
JARVIS_VOZ=es-BO-SofiaNeural
