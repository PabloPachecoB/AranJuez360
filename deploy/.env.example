# Copia como deploy/.env en el VPS. No subas deploy/.env a Git.
# El DNS A de este hostname debe apuntar al VPS. Caddy compartido lo usa para HTTPS.
DOMINIO=aranjuez.example.com
USAR_HTTPS=True

# PostgreSQL (solo accesible desde la red privada Docker)
POSTGRES_DB=paseo360
POSTGRES_USER=paseo360
POSTGRES_PASSWORD=cambia-esta-clave-larga

# Django
DEBUG=False
USE_LOCAL_DB=False
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=aranjuez.example.com
CSRF_TRUSTED_ORIGINS=https://aranjuez.example.com
# La web se sirve en el mismo dominio que la API.
CORS_ALLOWED_ORIGINS=https://aranjuez.example.com

# Enlaces que van en correos y WhatsApp
WEB_PANEL_URL=https://aranjuez.example.com
PUBLIC_BASE_URL=https://aranjuez.example.com
APP_DEEP_LINK=paseo360:/

# Correo (Gmail con contraseña de aplicación)
# True solo para presentaciones: los códigos demo se ven con docker compose logs backend.
CODIGOS_DEMO_EN_LOG=False
EMAIL_DEMO_REDIRIGIR=
EMAIL_BACKEND=paseo_erp.correo.SmtpSinDemoBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Paseo Aranjuez 360 <tu-correo@gmail.com>

# Jarvis (Qwen en DashScope)
LLM_PROVIDER=qwen_cloud
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_AUDIO_MODEL=qwen3.8-omni-flash
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=30
QWEN_TEMPERATURE=0
QWEN_MAX_TOKENS=512
AGENT_CHECKPOINT_BACKEND=sqlite

# Voz de salida de Jarvis. Para activar Fish Audio, elige fish_audio y completa su clave y reference ID de voz.
JARVIS_TTS_PROVIDER=
# Fish Audio: model s2.1-pro | s2.1-pro-free y reference ID de voz de tu cuenta.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
# ElevenLabs sigue disponible cuando JARVIS_TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_v3
JARVIS_VOZ=es-BO-SofiaNeural
