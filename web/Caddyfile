# {$DOMINIO} viene de deploy/.env (ej. paseo360.com). Caddy obtiene y renueva el HTTPS solo.
{$DOMINIO} {
	encode gzip

	# Backend Django: API, refresh de tokens, admin de Django e invitaciones con QR.
	@backend path /api/* /auth/* /admin/* /invitacion/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Archivos de Django: estáticos del admin e imágenes subidas (logos, fotos, pósters).
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Panel web (React): cualquier otra ruta cae en index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
